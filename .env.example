# Copy this file to .env for local testing (never commit .env to git)

# Anthropic API key — get it at https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# Gmail address used to SEND the email
GMAIL_USER=your.address@gmail.com

# Gmail App Password (NOT your normal password)
# How to get it: Google Account → Security → 2-Step Verification → App passwords
# Generate one for "Mail" + "Other device" and paste the 16-char code below
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Email address that RECEIVES the newsletter
RECIPIENT_EMAIL=martin@frayleon.com
